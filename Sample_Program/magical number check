//Checking magical number: 
//Here we convert number to String (Binary) then convert 1 to 2 and 0 to 1. we then add them together if sum=odd number then it's a magical number 

import java.util.*;

public class Main
{
	public static void main(String[] args) {
		
		Scanner sc=new Scanner(System.in);
		
		System.out.println("Enter number to check it's a magical number");
		
		int num=sc.nextInt();
		
		int count=0;
		
		while(num>0){
		    
		    String binary=Integer.toBinaryString(num);
		    
		    StringBuilder sb=new StringBuilder();
		    
		    for(int i=0;i<binary.length();i++){
		        if(binary.charAt(i)=='0') sb.append("1");
		        else sb.append("2");
		    }
		    
		    int sum=0;
		    for(char ch:sb.toString().toCharArray()){
		        sum+=(ch-'0');
		        
		    }
		    
		    if(sum%2==1) count++;
		    
		    num--;
		}
		System.out.println(count);
	}
}
